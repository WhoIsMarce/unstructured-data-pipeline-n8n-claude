# ==============================================================================
# UNSTRUCTURED DATA PIPELINE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env'. 
# If USE_MOCK_AI=true, no paid Anthropic API key is required.

# Set to 'true' to use local simulation (Free, no API required)
# Set to 'false' to use the real Anthropic API
USE_MOCK_AI=true

# Anthropic Claude API Configuration (Optional if USE_MOCK_AI=true)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# n8n Workflow Automation Engine Configuration
N8N_ENCRYPTION_KEY=secure_random_encryption_string_here
WEBHOOK_URL=http://localhost:5678/webhook/pipeline-trigger

# Database & Logging Configuration
DATABASE_URL=sqlite+aiosqlite:///./pipeline_local.db
LOG_LEVEL=INFO
ENVIRONMENT=development